meta {
  name: Get Transaction
  type: http
  seq: 4
}

get {
  url: {{ledgerUrl}}/transactions/{{transactionId}}
  body: none
  auth: none
}

tests {
  test("returns the folded transaction", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().transaction.id).to.equal(bru.getVar("transactionId"));
  });
}

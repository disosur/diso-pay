meta {
  name: Get Payment Status
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/payment/{{transactionId}}/status
  body: none
  auth: none
}

tests {
  test("returns the folded status and status history", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().transaction.id).to.equal(bru.getVar("transactionId"));
    expect(res.getBody().transaction.status).to.be.a("string");
    expect(res.getBody().transaction.url).to.include(
      "/payment/" + bru.getVar("transactionId"),
    );
    expect(res.getBody().status_history).to.be.an("array").that.is.not.empty;
    expect(res.getBody().status_history[0].type).to.equal("transaction.created");
    expect(res.getBody().status_history[0].payload).to.be.an("object");
    expect(res.getBody().status_history[0].payload.currency).to.be.a("string");
  });
}

meta {
  name: Get Transaction Status
  type: http
  seq: 6
}

get {
  url: {{ledgerUrl}}/transactions/{{transactionId}}/status
  body: none
  auth: none
}

tests {
  test("returns the folded status and status history", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().transaction.id).to.equal(bru.getVar("transactionId"));
    expect(res.getBody().transaction.status).to.be.a("string");
    expect(res.getBody().status_history).to.be.an("array").that.is.not.empty;
    expect(res.getBody().status_history[0].type).to.equal("transaction.created");
  });
}

meta {
  name: Create Payment (reuse)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/payment/process
  body: json
  auth: none
}

body:json {
  {
    "currency": "PHP",
    "success_url": "https://example.com/checkout/success",
    "cancel_url": "https://example.com/checkout/cancel",
    "customer_reference_id": "{{orderId}}",
    "description": "Order {{orderId}}",
    "line_items": [
      {
        "name": "Hello",
        "amount": 50000,
        "quantity": 1
      }
    ]
  }
}

tests {
  test("reuses the active transaction", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().reused).to.equal(true);
    expect(res.getBody().id).to.equal(bru.getVar("transactionId"));
  });
}

meta {
  name: Create Payment
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/payment/process
  body: json
  auth: none
}

body:json {
  {
    "currency": "PHP",
    "success_url": "https://example.com/checkout/success",
    "cancel_url": "https://example.com/checkout/cancel",
    "customer_reference_id": "{{orderId}}",
    "description": "Order {{orderId}}",
    "line_items": [
      {
        "name": "Hello",
        "amount": 50000,
        "quantity": 2
      }
    ],
    "metadata": {
      "order_id": "{{orderId}}"
    }
  }
}

script:pre-request {
  bru.setVar("orderId", `order_${Math.random().toString(36).slice(2, 12)}`);
}

tests {
  test("creates a transaction", function () {
    expect([200, 201]).to.include(res.getStatus());
    expect(res.getBody().url).to.be.a("string");
    expect(res.getBody().status).to.equal("pending");
    bru.setVar("transactionId", res.getBody().id);
  });
}

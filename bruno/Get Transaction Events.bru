meta {
  name: Get Transaction Events
  type: http
  seq: 5
}

get {
  url: {{ledgerUrl}}/transactions/{{transactionId}}/events
  body: none
  auth: none
}

tests {
  test("returns the append-only events", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().events.length).to.be.above(0);
  });
}

PORT=4012
PAYMENT_GRPC_HOST=127.0.0.1
PAYMENT_GRPC_PORT=50052
LEDGER_GRPC_ADDRESS=127.0.0.1:50051
PROCESSOR_PUBLIC_URL=http://localhost:3000
# Xendit requires public HTTPS return URLs. Set this to a public/tunnel URL
# (e.g. https://abc.trycloudflare.com) to keep return tracking with Xendit.
CHECKOUT_RETURN_BASE_URL=
# Fallback USD to PHP rate used when Stripe FX Quotes are unavailable.
FX_PHP_PER_USD=58
# Stripe FX Quotes lock duration: none, five_minutes, hour, or day.
FX_STRIPE_LOCK_DURATION=hour
TRANSACTION_TTL_SECONDS=1800

XENDIT_SECRET_API_KEY=
XENDIT_API_BASE_URL=https://api.xendit.co
XENDIT_WEBHOOK_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_BASE_URL=https://api.stripe.com
LOG_LEVEL=info
# LOG_FORMAT=json

{
  "name": "diso-pay",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "build": "bun run --cwd apps/processor build",
    "db:generate": "bun run --cwd apps/ledger db:generate",
    "db:migrate": "bun run --cwd apps/ledger db:migrate",
    "test": "bun test",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.5.4"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
